# Ambiente de SANDBOX — ver docs/15-sandbox.md
#
# Copie para .env.sandbox e preencha o que estiver marcado como "copiar do .env".
# Este arquivo é o par isolado do .env (que é o de PRODUÇÃO, não de dev).
#
# Regra de ouro: nada aqui pode apontar para lidimus.gvlar.com nem para o
# bucket/banco/Redis de produção. As chaves de serviços externos com efeito
# no mundo real (Resend, Stripe, Google OAuth, Sentry) ficam VAZIAS de
# propósito — o código já degrada limpo quando faltam.

# Banco e Redis: containers próprios do compose de sandbox (5433/6380 no host)
DATABASE_URL=postgresql://lidimus:lidimus@postgres:5432/lidimus
REDIS_URL=redis://redis:6379

# Better Auth — segredo PRÓPRIO, para que sessão de produção não valha aqui
# (e vice-versa). Gerar com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://host.docker.internal:3100

# n8n — os MESMOS workflows de produção. Eles recebem callbackUrl e fileUrl
# pelo payload, então atendem o sandbox sem duplicação.
# copiar do .env:
N8N_BASE_URL=https://n8n.gvlar.com
N8N_API_KEY=
N8N_MATRICULA_OCR_WEBHOOK_PATH=/webhook/lidimus-ocr
N8N_MATRICULA_JURIDICO_WEBHOOK_PATH=/webhook/lidimus-juridico
N8N_MATRICULA_DOC_WEBHOOK_PATH=/webhook/lidimus-doc
N8N_CROQUI_WEBHOOK_PATH=/webhook/lidimus-croqui
N8N_KML_WEBHOOK_PATH=/webhook/descritor-terreno-kml
N8N_INJECTION_WEBHOOK_PATH=/webhook/pdf-report

# Segredo PRÓPRIO: um callback de produção que chegasse aqui por engano (ou o
# contrário) é rejeitado. Gerar com: openssl rand -hex 32
N8N_CALLBACK_SECRET=

# Endereço pelo qual o n8n alcança o sandbox. O container do n8n roda nesta
# mesma máquina, então host.docker.internal resolve para o host e chega na
# porta 3100 — sem túnel novo.
PUBLIC_BASE_URL=http://host.docker.internal:3100

# Google Cloud Storage — MESMA service account, BUCKET SEPARADO.
# copiar GOOGLE_CLOUD_PROJECT_ID e GOOGLE_CLOUD_SA_KEY_JSON do .env:
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_SA_KEY_JSON=
GCS_BUCKET_NAME=lidimus-sandbox-files

# Limites (mesmos defaults de produção)
UPLOAD_RATE_LIMIT_PER_HOUR=60
MAX_UPLOAD_SIZE_MB=50
MAX_BATCH_FILES=10
MAX_BATCH_TOTAL_MB=120
API_RATE_LIMIT_PER_HOUR=120

# Job sem callback vira erro + estorno. 180 em vez de 60 porque no sandbox é
# normal parar num breakpoint enquanto o job está em voo.
STUCK_JOB_TIMEOUT_MINUTES=180

# E-mail: chave VAZIA faz sendEmail() imprimir no console em vez de enviar
# (apps/web/server/lib/email.ts). Não preencher — cadastro de teste com chave
# real manda e-mail de verdade pelo domínio da empresa.
RESEND_API_KEY=
EMAIL_FROM=Lidimus Sandbox <sandbox@localhost>
REQUIRE_EMAIL_VERIFICATION=false

# Login Google: vazio faz o botão sumir e o cadastro por senha basta. Ligar
# exigiria cadastrar http://localhost:3100/api/auth/callback/google no Console
# do Google — só vale a pena para testar o fluxo social especificamente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe: vazio faz os endpoints de billing devolverem 503
# (apps/web/server/lib/stripe.ts). Para testar cobrança, usar chaves de teste
# PRÓPRIAS + `stripe listen --forward-to localhost:3100/api/webhooks/stripe`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry vazio: erro de sandbox não polui o projeto de produção
SENTRY_DSN=
SENTRY_ENVIRONMENT=sandbox

# Câmbio do painel de custos
USD_BRL_RATE=5.45

# CLOUDFLARE_TUNNEL_TOKEN não existe aqui de propósito — o compose de sandbox
# não tem serviço cloudflared, e o sandbox não vai para a internet.

# ─── Espelhos NUXT_* ─────────────────────────────────────────────────────────
# Obrigatórios, não decorativos. O container `web` roda o Nuxt BUILDADO: o
# nuxt.config foi executado no build e os process.env do runtimeConfig já
# viraram valores fixos. Em runtime, só NUXT_<CHAVE> sobrescreve — o nome sem
# prefixo é ignorado (sintoma clássico: "DATABASE_URL not configured" com a
# variável visivelmente presente no container). O worker é o oposto: lê
# process.env direto, pelos nomes sem prefixo.
#
# Repita aqui, com o MESMO valor, cada chave abaixo. `pnpm sandbox:up` recusa
# subir se algum par divergir.
NUXT_DATABASE_URL=postgresql://lidimus:lidimus@postgres:5432/lidimus
NUXT_REDIS_URL=redis://redis:6379
NUXT_BETTER_AUTH_SECRET=
NUXT_N8N_CALLBACK_SECRET=
NUXT_PUBLIC_BASE_URL=http://host.docker.internal:3100
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_RESEND_API_KEY=
NUXT_EMAIL_FROM=Lidimus Sandbox <sandbox@localhost>
NUXT_REQUIRE_EMAIL_VERIFICATION=false
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
NUXT_USD_BRL_RATE=5.45
NUXT_UPLOAD_RATE_LIMIT_PER_HOUR=60
NUXT_API_RATE_LIMIT_PER_HOUR=120
NUXT_MAX_UPLOAD_SIZE_MB=50
NUXT_MAX_BATCH_FILES=10
NUXT_MAX_BATCH_TOTAL_MB=120
