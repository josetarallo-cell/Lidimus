# Banco de dados
DATABASE_URL=postgresql://lidimus:lidimus@postgres:5432/lidimus

# Redis
REDIS_URL=redis://redis:6379

# Better Auth
BETTER_AUTH_SECRET=change-me-in-production-32-chars-min
BETTER_AUTH_URL=http://localhost:3000
# Origens aceitas além da derivada de PUBLIC_BASE_URL (lista separada por vírgula).
# Necessário quando o mesmo container atende o domínio público e o localhost:
# sem isso, login e cadastro em http://localhost:3000 respondem "Invalid origin".
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# n8n — webhooks de entrada (URLs dos workflows no n8n externo)
N8N_BASE_URL=https://n8n.gvlar.com

# Chave da Public API do n8n — usada pelo MCP n8n-mcp e por scripts de
# manutenção dos workflows; o runtime do app NÃO usa esta chave
N8N_API_KEY=
N8N_MATRICULA_OCR_WEBHOOK_PATH=/webhook/lidimus-ocr
N8N_MATRICULA_JURIDICO_WEBHOOK_PATH=/webhook/lidimus-juridico
N8N_MATRICULA_DOC_WEBHOOK_PATH=/webhook/lidimus-doc
N8N_CROQUI_WEBHOOK_PATH=/webhook/lidimus-croqui
N8N_KML_WEBHOOK_PATH=/webhook/descritor-terreno-kml
N8N_INJECTION_WEBHOOK_PATH=/webhook/pdf-report

# Segredo compartilhado entre Nuxt e n8n para validar callbacks
N8N_CALLBACK_SECRET=change-me-shared-with-n8n

# URL pública do Nuxt (usada pelo n8n para baixar arquivos e fazer callback)
PUBLIC_BASE_URL=http://localhost:3000

# Google Cloud — Service Account JSON completo (em uma linha ou como string JSON)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_SA_KEY_JSON=
# Bucket GCS para armazenamento temporário de arquivos (criado automaticamente pelo script)
GCS_BUCKET_NAME=lidimus-job-files

# Limites de upload (Fase 1 do roadmap) — opcionais, defaults no nuxt.config.ts
UPLOAD_RATE_LIMIT_PER_HOUR=60
MAX_UPLOAD_SIZE_MB=50

# Envio de matrículas em lote. MAX_BATCH_FILES é o teto de PDFs por lote — cada
# arquivo vira uma execução do n8n, e a espera na fila conta para o watchdog
# (STUCK_JOB_TIMEOUT_MINUTES), então subir este número exige refazer essa conta.
# MAX_BATCH_TOTAL_MB limita o lote inteiro porque o Nitro bufferiza o corpo da
# requisição em memória.
MAX_BATCH_FILES=10
MAX_BATCH_TOTAL_MB=120

# Teto por hora da API pública (por organização e por chave), separado do limite
# do painel — integração de lote submete mais que gente clicando.
API_RATE_LIMIT_PER_HOUR=120

# Fase 3 — override global da concorrência dos workers BullMQ (defaults por fila:
# injection/kml 10, ocr/doc 5, juridico 3). Antes de aumentar, confirmar o
# throughput que o n8n externo sustenta.
# WORKER_CONCURRENCY=5
# Job sem callback do n8n há mais de X minutos é expirado pelo watchdog do
# worker (vira erro + estorno de créditos). Default 15. Mede uma ETAPA e não o
# pipeline: `updatedAt` é reescrito a cada transição. Baixar demais mata job que
# ainda está sendo processado (o callback atrasado é recusado, e o cliente fica
# com o estorno sem o relatório) — antes de mexer, medir as etapas reais.
# STUCK_JOB_TIMEOUT_MINUTES=15
# Corretor de leitura: minutos que o job espera a conferência do usuário antes
# de a análise seguir sozinha com a leitura original. Não gera erro nem estorno —
# o cliente recebe o relatório de qualquer jeito. Default 15.
#
# A tela promete este mesmo número ao usuário, lendo-o de
# runtimeConfig.public.revisaoPrazoMinutos (nuxt.config.ts), que usa a mesma
# variável: mudar aqui muda os dois. Definir só num lado faz a tela mentir.
# REVISAO_PRAZO_MINUTOS=15
# Recortes de página feitos em paralelo pelo worker de revisão (CPU). Default 2.
# WORKER_REVISAO_CONCURRENCY=2
# Réplicas do worker em produção (docker-compose.prod.yml)
# WORKER_REPLICAS=1
# Rastreamento de erros (web + workers) — inativo se vazio
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Atrás de PgBouncer em modo transaction (produção) — ver docs/20-deploy.md
# DB_DISABLE_PREPARE=true

# Fase 4 — e-mail transacional (recuperação de senha). Sem chave, o link de
# redefinição é logado no console do web (só serve para dev).
RESEND_API_KEY=
EMAIL_FROM=Lidimus <onboarding@resend.dev>

# Exige confirmação do e-mail antes do primeiro login por senha.
# PRÉ-REQUISITO: EMAIL_FROM em domínio verificado no Resend — com o remetente
# onboarding@resend.dev a entrega só chega ao dono da conta Resend e todo
# cadastro novo trava. Ligar só depois de verificar o domínio.
# Ligar isto também reativa a exigência de e-mail verificado para vincular
# login Google a uma conta de senha já existente.
REQUIRE_EMAIL_VERIFICATION=false

# Verificador de autenticidade de documento (@lidimus/autenticidade). A perícia
# do arquivo e as âncoras (selo TJSP, CNM) rodam sempre; esta chave liga só a
# consulta à API pública da ONR (assinador-web.onr.org.br), que é a mais forte
# das verificações e a única que depende de um serviço externo não documentado.
AUTENTICIDADE_ONR_ENABLED=false

# Fase 4 — login social Google (console.cloud.google.com > Credentials > OAuth client).
# Redirect URI: <PUBLIC_BASE_URL>/api/auth/callback/google. Sem credenciais, o botão não aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (Fase 2) — usar chaves de TESTE (sk_test_...) até a empresa ter conta definitiva.
# STRIPE_WEBHOOK_SECRET vem do endpoint de webhook (dashboard) ou do `stripe listen` local.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Claude API (para uso futuro direto nos workers)
ANTHROPIC_API_KEY=

# Lidimus Update — token do agente de deploy (scripts/update-agent.mjs).
#
# É credencial de execução remota de código: quem tem este valor dispara
# git push, docker build e docker compose up nesta máquina. O agente escuta só
# em 127.0.0.1, mas isso alcança todo container e todo processo local.
#
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# O mesmo valor vai na credencial "Lidimus Update - agente do host" no n8n,
# como header Authorization: Bearer <valor>. Ver docs/25-lidimus-update.md.
LIDIMUS_UPDATE_TOKEN=

# Para onde aponta o link "Aprovar e subir agora" que vai no WhatsApp — é o
# webhook do workflow `Lidimus Aprovar`. Só precisa mexer se o n8n mudar de
# endereço; o valor abaixo já é o padrão embutido nos scripts.
LIDIMUS_APROVAR_URL=https://n8n.gvlar.com/webhook/lidimus-aprovar

# Validade do link de aprovação, em horas. 18h cobre o intervalo entre o
# relatório das 5h e o fim do dia útil, e entre o lembrete das 22h e a tarde
# seguinte. Encurtar reduz a janela em que um print do WhatsApp vale um deploy.
LIDIMUS_TICKET_HORAS=18
